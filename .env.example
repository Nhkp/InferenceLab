APP_ENV=local
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
VLLM_BASE_URL=http://127.0.0.1:8001
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_TIMEOUT_SECONDS=180
VLLM_STREAM_IDLE_TIMEOUT_SECONDS=30
PROMETHEUS_ENABLED=false
STORE_PROMPT_CONTENT=false
# DATABASE_URL is optional; omit it for standalone benchmark artifacts.
