# Optional Linux x86_64 GPU image. A successful build is not GPU validation.
FROM python:3.12.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.9 /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH" \
    HF_HOME="/home/app/.cache/huggingface"
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --locked --no-dev --no-editable --extra gpu \
    && useradd --create-home --uid 10001 app \
    && mkdir -p /app/results /home/app/.cache/huggingface \
    && chown -R app:app /app/results /home/app/.cache
USER app
ENTRYPOINT ["python", "-m", "inference_lab.serving"]
